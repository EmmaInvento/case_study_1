# Copy to .env and set your own provider credentials privately.
# Only .env in the current directory is read, or the exact --env-file path.
# Priority: CLI overrides > process environment > file. No ${...} interpolation.
# Never put credentials in the URL. Use the base URL, WITHOUT /chat/completions.
OPENAI_BASE_URL=https://api.example.invalid/v1
OPENAI_API_KEY=replace-with-your-key
OPENAI_MODEL=replace-with-your-model

# json_schema requires strict Structured Outputs support.
# Choose json_object explicitly only if your provider supports JSON mode instead.
# Local schema/reference validation always applies; no automatic fallback.
NIS2_RESPONSE_FORMAT=json_schema

# Optional: none, minimal, low, medium, high, xhigh. Support depends on the model.
# Empty means omit reasoning_effort and leave the provider default unclaimed.
OPENAI_REASONING_EFFORT=
